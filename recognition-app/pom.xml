<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>recognition-app</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>recognition-app</name>
    <description>Employee Recognition Platform</description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.5.4</version> <!-- Use a specific, stable version -->
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <properties>
        <java.version>11</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.thymeleaf.extras</groupId>
            <artifactId>thymeleaf-extras-springsecurity6</artifactId>
            <!-- Version will be managed by Spring Boot BOM -->
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.hibernate.tool</groupId>
                <artifactId>hibernate-tools-maven</artifactId>
                <version>5.4.32.Final</version> <!-- Use a recent version compatible with Spring Boot's Hibernate -->
                <dependencies>
                    <dependency>
                        <groupId>org.hibernate</groupId>
                        <artifactId>hibernate-core</artifactId>
                        <version>5.4.32.Final</version> <!-- Ensure this matches your Spring Boot Hibernate version if possible -->
                    </dependency>
                    <dependency>
                        <groupId>javax.xml.bind</groupId>
                        <artifactId>jaxb-api</artifactId>
                        <version>2.3.1</version> <!-- Required for Java 9+ -->
                    </dependency>
                     <dependency>
                        <groupId>com.h2database</groupId>
                        <artifactId>h2</artifactId>
                        <version>1.4.200</version> <!-- Ensure this version is compatible -->
                    </dependency>
                </dependencies>
                <configuration>
                    <packageName>com.example.recognitionapp.model</packageName>
                    <outputDirectory>${project.build.directory}/generated-ddl</outputDirectory>
                    <ejb3>true</ejb3>
                    <hbm2ddl>
                        <property key="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
                        <property key="hibernate.hbm2ddl.auto" value="create"/>
                        <property key="javax.persistence.schema-generation.database.action" value="create"/>
                        <property key="javax.persistence.schema-generation.scripts.action" value="create"/>
                        <property key="javax.persistence.schema-generation.scripts.create-target" value="${project.build.directory}/generated-ddl/schema.sql"/>
                        <property key="javax.persistence.create-database-schemas" value="true"/>
                    </hbm2ddl>
                </configuration>
                <executions>
                    <execution>
                        <id>generate-ddl</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>hbm2ddl</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version> <!-- Use a recent version -->
                <configuration>
                    <mainClass>GenerateSchema</mainClass>
                    <classpathScope>test</classpathScope> <!-- Important: includes test classpath -->
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
